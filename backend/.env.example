# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://policywise_user:policywise_pass@localhost:5432/policywise

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM (wire this up when you integrate the real chatbot)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
